# Ignore bundled gems and dependencies
/.bundle
/vendor/bundle

# Ignore database logs and storage
/db/*.sqlite3
/db/*.sqlite3-*
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Uploaded assets and storage
/storage/*
!/storage/.keep
/public/assets


# IDE and OS metadata
.DS_Store
.idea/
.vscode/
*.swp
*.tmp
