# Ignore bundled gems and dependencies
/.bundle
/vendor/bundle

# Ignore database logs and storage
/db/*.sqlite3
/db/*.sqlite3-*
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded assets and storage
/storage/*
!/storage/.keep
/public/assets

# Ignore environment & secret files
/.env
/.env.*
/config/master.key
/config/credentials/*.key

# IDE and OS metadata
.DS_Store
.idea/
.vscode/
*.swp
*.tmp
